{
  "name": "@cryptoapis-io/mcp",
  "version": "0.5.0",
  "description": "Combined Crypto APIs MCP server — address history, block data, market data, broadcast, transactions, fees, HD wallets, and more, in one process",
  "license": "MIT",
  "author": "Crypto APIs, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/CryptoAPIs-io/cryptoapis-mcp-hub.git",
    "directory": "mcp"
  },
  "mcpName": "io.github.CryptoAPIs-io/mcp",
  "keywords": [
    "mcp",
    "cryptoapis",
    "blockchain",
    "crypto",
    "ai",
    "claude",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/test/**",
    "README.md",
    "server.json"
  ],
  "bin": {
    "cryptoapis-mcp": "dist/cli.js"
  },
  "dependencies": {
    "@cryptoapis-io/mcp-address-history": "0.4.0",
    "@cryptoapis-io/mcp-address-latest": "0.4.0",
    "@cryptoapis-io/mcp-aml": "0.3.0",
    "@cryptoapis-io/mcp-block-data": "0.4.0",
    "@cryptoapis-io/mcp-blockchain-events": "0.5.0",
    "@cryptoapis-io/mcp-blockchain-fees": "0.5.1",
    "@cryptoapis-io/mcp-broadcast": "0.5.0",
    "@cryptoapis-io/mcp-contracts": "0.4.0",
    "@cryptoapis-io/mcp-hd-wallet": "0.4.0",
    "@cryptoapis-io/mcp-market-data": "0.4.0",
    "@cryptoapis-io/mcp-prepare-transactions": "0.5.0",
    "@cryptoapis-io/mcp-shared": "0.4.0",
    "@cryptoapis-io/mcp-simulate": "0.4.0",
    "@cryptoapis-io/mcp-transactions-data": "0.4.0",
    "@cryptoapis-io/mcp-utils": "0.4.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.0"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"console.log('lint: add eslint if you want')\"",
    "test": "node --test --test-force-exit dist/test/*.test.js",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.5.4"
  }
}
